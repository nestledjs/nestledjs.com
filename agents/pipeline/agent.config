{
  "name": "Pipeline",
  "description": "Per-repo pipeline for nestledjs.com \u2014 FlightDesk-dispatched turns, review loops, merge/deploy.",
  "context": "coderepos",
  "project": "nestledjs.com",
  "command": "claude --dangerously-skip-permissions",
  "timeout_minutes": 180,
  "idle_timeout_minutes": 60,
  "coding": true,
  "env": {
    "CLAUDE_MCP_FLIGHTDESK_AUTHORIZATION": "Bearer ${FLIGHTDESK_API_KEY}"
  },
  "worktrees": true,
  "memory_high": "2G",
  "memory_max": "3G"
}
