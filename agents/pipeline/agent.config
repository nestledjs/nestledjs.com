{
  "name": "Pipeline",
  "description": "Per-repo pipeline for nestledjs.com \u2014 Linear-driven monitoring, review loops, merge/deploy.",
  "context": "coderepos",
  "project": "nestledjs.com",
  "command": "claude --dangerously-skip-permissions",
  "timeout_minutes": 45,
  "coding": true,
  "env": {
    "CLAUDE_MCP_FLIGHTDESK_AUTHORIZATION": "Bearer ${FLIGHTDESK_API_KEY}"
  }
}
